# Copy to .env and fill real values. NEVER commit .env.

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://localhost:9000
S3_BUCKET=datathon

# Trino
TRINO_HOST=localhost
TRINO_PORT=8080

# Iceberg
ICEBERG_WAREHOUSE=s3a://datathon/warehouse

# PostgreSQL (Iceberg JDBC catalog metadata store — KHÔNG SQLite)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iceberg_catalog

# Iceberg REST catalog (tabulario/iceberg-rest, backend=Postgres JDBC, storage=MinIO)
# Host-side (jobs/*.py chạy trên máy host): dùng localhost + port publish.
# Trong container (trino/spark): dùng DNS nội bộ compose "iceberg-rest:8181" (hardcode trong
# infra/trino/etc/catalog/iceberg.properties + infra/spark/spark-defaults.conf — không phải secret
# nên không cần qua .env).
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_CATALOG=iceberg
AWS_REGION=us-east-1

# CloudBeaver
CLOUDBEAVER_PORT=8978

# Iceberg maintenance retention (jobs/expire_snapshots.py)
SNAPSHOT_RETENTION_DAYS=7

# Data paths
DATA_RAW_PATH=data/raw
